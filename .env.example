# Copy to .env (git-ignored), fill in, then load it into your shell:
#   set -a && source .env && set +a
# Only needed for --destination postgres. The CSV default needs none of this.

# Required for PostgreSQL. No defaults: the pipeline refuses to start without them.
DB_USER=
DB_PASSWORD=

# Optional (defaults shown)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio
DB_CONNECT_TIMEOUT=10

# Pipeline defaults (also settable as CLI flags)
ETL_DESTINATION=csv
LOG_LEVEL=INFO
